{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_FILE_PATH\" in *.env|*.env.*|*.env.local) echo '⚠️ 禁止编辑 .env 文件，请手动修改以保护敏感信息' && exit 1 ;; *) exit 0 ;; esac",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "eslint --fix --stdin-filepath \"$CLAUDE_FILE_PATH\" < \"$CLAUDE_FILE_PATH\"",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "pnpm run type-check",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
