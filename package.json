{
  "name": "maptile-proxy",
  "type": "module",
  "version": "1.1.5",
  "packageManager": "pnpm@11.17.0",
  "description": "A map tile proxy server",
  "author": "",
  "license": "ISC",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch --max-old-space-size=3072 --optimize-for-size --env-file .env.local src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:canvas --external:pino --external:pino-pretty --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@hono/node-server": "^2.0.12",
    "canvas": "^3.2.3",
    "hono": "^4.12.32",
    "nodom": "^2.4.0",
    "ol": "^10.10.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
