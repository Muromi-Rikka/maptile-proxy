{
  "name": "maptile-proxy",
  "type": "module",
  "version": "1.2.0",
  "packageManager": "pnpm@12.4.1",
  "description": "A map tile proxy server",
  "author": "",
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch --max-old-space-size=3072 --optimize-for-size --env-file .env.local src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:canvas --external:pino --external:pino-pretty --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@hono/node-server": "^2.1.1",
    "canvas": "^3.2.3",
    "hono": "^4.13.7",
    "nodom": "^2.4.0",
    "ol": "^10.10.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@renton/eslint-config": "^1.1.0",
    "@types/node": "^24.13.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
